# ── Local credentials ─────────────────────────────────────────────────────────
# Do NOT commit real values. Run `npm run env:init` to generate random passwords into your
# git-ignored .env (it also rewrites DATABASE_URL / REDIS_URL below to match).
# The `change-me` placeholders are only used by CI config validation.
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# PostgreSQL connection string
DATABASE_URL=postgres://reapd:change-me@localhost:5432/reapd

# Redis connection string (used for BullMQ queues, cancel pub/sub, and log streams)
REDIS_URL=redis://:change-me@localhost:6379

# Docker Socket Proxy (running in infra/docker-compose.yml)
DOCKER_PROXY_HOST=127.0.0.1
DOCKER_PROXY_PORT=2375

# API server host/port (host defaults to loopback; set 0.0.0.0 only if you intend to expose it)
REAPD_API_HOST=127.0.0.1
PORT=3001

# GitHub App credentials
# Provide either GITHUB_PRIVATE_KEY_PATH (path to .pem file) or GITHUB_PRIVATE_KEY (inline PEM with \n)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY_PATH=
# GITHUB_PRIVATE_KEY=

# Optional dev/smoke override for git clone source URL (ignored when NODE_ENV=production)
# REAPD_REPO_URL_OVERRIDE=

# Note: NODE_EXTRA_CA_CERTS is read by Node at process startup (before .env is loaded),
# so export it in your shell before running the worker against local mkcert domains:
#   export NODE_EXTRA_CA_CERTS="$(mkcert -CAROOT)/rootCA.pem"
