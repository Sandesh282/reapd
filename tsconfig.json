{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@reapd/types": ["./packages/types/src/index.ts"],
      "@reapd/db": ["./packages/db/src/index.ts"],
      "@reapd/docker-client": ["./packages/docker-client/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}

