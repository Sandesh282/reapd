{
  "name": "@reapd/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "cli": "node --import tsx src/cli/reapd-cli.ts",
    "dev": "tsx watch src/index.ts",
    "dev:worker": "REAPD_ROLE=worker tsx watch src/index.ts",
    "dev:reconciler": "REAPD_ROLE=reconciler tsx watch src/index.ts",
    "build": "tsc",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@reapd/db": "*",
    "@reapd/docker-client": "*",
    "@reapd/types": "*",
    "bullmq": "^5.34.4",
    "ioredis": "^5.4.2",
    "playwright-core": "^1.65.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
